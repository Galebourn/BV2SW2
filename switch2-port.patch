diff --git a/switch2/Dockerfile b/switch2/Dockerfile
new file mode 100644
index 0000000..8bda2d9
--- /dev/null
+++ b/switch2/Dockerfile
@@ -0,0 +1,18 @@
+FROM devkitpro/devkita64:20260219 AS build
+RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl cmake ninja-build libboost-dev && rm -rf /var/lib/apt/lists/*
+COPY switch2/install-ounce.sh /tmp/install-ounce.sh
+RUN sh /tmp/install-ounce.sh && dkp-pacman -S --needed --noconfirm switch-sdl2 switch-physfs
+WORKDIR /src
+COPY . .
+# Boost is header-only in this game. Isolate its headers from host libc headers.
+RUN mkdir -p deps/boost-headers && cp -a /usr/include/boost deps/boost-headers/
+RUN cmake -S . -B build-switch2 -G Ninja \
+    -DCMAKE_TOOLCHAIN_FILE=/opt/devkitpro/libounce/cmake/Switch2.cmake \
+    -DSWITCH2=ON -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_INSTALL_PREFIX=/out/switch/blobby2 \
+    && cmake --build build-switch2 --parallel 2 \
+    && cmake --install build-switch2
+RUN mkdir -p /out/switch/blobby2/user /out/licenses && cp COPYING AUTHORS /out/licenses/ \
+    && dkp-pacman -Q > /out/build-packages.txt
+FROM scratch AS export
+COPY --from=build /out/ /
diff --git a/switch2/README.txt b/switch2/README.txt
new file mode 100644
index 0000000..d3f11c6
--- /dev/null
+++ b/switch2/README.txt
@@ -0,0 +1,57 @@
+Blobby Volley 2 — experimental Switch 2 / kaiHEN port
+
+STATUS: SOURCE DRAFT ONLY. Not compiled or tested on hardware. No NRO is
+included in this source package. Further compile/link/runtime fixes may be needed.
+
+Based on danielknobe/blobbyvolley2 commit:
+c28c5fa87872b7592f34f5f86196e93d127b6cf9
+The included ounce installer is from ouncebrew/ounce-devkit commit:
+5e957599bd498643d82e5470aec80da67a12685d (MIT; see ounce-LICENSE).
+SDK packages are rolling versions; successful builds record build-packages.txt.
+
+Build on a machine with Docker and access to devkitPro/ounce package servers:
+  docker build --file switch2/Dockerfile --output type=local,dest=dist .
+Run from the repository root. Alternatively upload this source to your own
+GitHub repository and run the manual 'Experimental Switch 2 kaiHEN build'
+workflow from Actions. No repository has been created or published for you.
+
+After a SUCCESSFUL build, copy dist/switch/blobby2 to /switch/blobby2 on the
+SD card. Keep the directory name: the port uses sdmc:/switch/blobby2/data.
+Launch blobby.nro through kaiHEN's homebrew menu in a native Switch 2 game.
+This package does not install or modify kaiHEN or console firmware.
+
+First-run defaults: left human player versus right AI; left stick moves;
+A jumps/selects; D-pad navigates; Plus goes back/pauses. These mappings are
+inherited from the original Switch SDL port and still require hardware testing.
+Configuration/replays are written below /switch/blobby2/user.
+To reset preferences, back up and remove that user directory's config files.
+
+Changes: ounce CMake toolchain integration; NRO packaging; explicit SDL/PhysFS
+static libraries and OunceVK EGL; separate SD preference directory; applet exit
+loop; socket initialization in release builds; SDL renderer error reporting;
+controller and AI defaults. The game logic and assets are upstream originals.
+
+Known unverified areas: compilation/link dependencies, GPU initialization,
+PhysFS SD support, controller enumeration and hotplug, audio, suspend/resume,
+network multiplayer. The immediate target is a local match against the AI.
+
+Hardware smoke test after compilation:
+1. Launch and check title/menu display, joystick navigation and audio.
+2. Start a local match; move, jump, score, and confirm the AI plays.
+3. Pause, return to menu, quit, and relaunch to check saved preferences.
+4. Report firmware, kaiHEN version, build-packages.txt and any error text.
+
+Local verification: git diff --check, XML parsing, patch applicability and
+source-package inspection. Cross-compilation was blocked: no devkitPro,
+Docker or installed WSL; package downloads returned HTTP 403; MSYS shell
+initialization also failed in the execution environment.
+
+Licensing: retain COPYING and AUTHORS. Blobby Volley 2 is GPL-2.0-or-later;
+individual bundled dependencies retain their upstream notices. The complete
+modified game source is included. Distribute corresponding source alongside
+any resulting binary, with relevant toolchain/library license notices.
+
+References:
+https://github.com/danielknobe/blobbyvolley2
+https://github.com/ouncebrew/ounce-devkit
+https://github.com/ouncebrew/kaihen
diff --git a/switch2/dependencies.cmake b/switch2/dependencies.cmake
new file mode 100644
index 0000000..2b6afd7
--- /dev/null
+++ b/switch2/dependencies.cmake
@@ -0,0 +1,16 @@
+# SDL's Switch package metadata pulls in Switch 1 Mesa. Resolve the static
+# libraries explicitly so the renderer links OunceVK and libounce instead.
+find_path(SWITCH_SDL_INCLUDE SDL.h PATHS "${DEVKITPRO}/portlibs/switch/include/SDL2" NO_DEFAULT_PATH REQUIRED)
+find_library(SWITCH_SDL SDL2 PATHS "${DEVKITPRO}/portlibs/switch/lib" NO_DEFAULT_PATH REQUIRED)
+find_path(SWITCH_PHYSFS_INCLUDE physfs.h PATHS "${DEVKITPRO}/portlibs/switch/include" NO_DEFAULT_PATH REQUIRED)
+find_library(SWITCH_PHYSFS physfs PATHS "${DEVKITPRO}/portlibs/switch/lib" NO_DEFAULT_PATH REQUIRED)
+find_library(OUNCE_EGL EGL PATHS "${DEVKITPRO}/portlibs/switch2/lib" NO_DEFAULT_PATH REQUIRED)
+find_path(BLOBBY_BOOST_INCLUDE boost/version.hpp HINTS "${CMAKE_SOURCE_DIR}/deps/boost-headers" NO_DEFAULT_PATH REQUIRED)
+add_library(SDL2::SDL2 STATIC IMPORTED GLOBAL)
+set_target_properties(SDL2::SDL2 PROPERTIES IMPORTED_LOCATION "${SWITCH_SDL}" INTERFACE_INCLUDE_DIRECTORIES "${SWITCH_SDL_INCLUDE}")
+add_library(SDL2::SDL2main INTERFACE IMPORTED GLOBAL)
+add_library(PhysFS::PhysFS STATIC IMPORTED GLOBAL)
+set_target_properties(PhysFS::PhysFS PROPERTIES IMPORTED_LOCATION "${SWITCH_PHYSFS}" INTERFACE_INCLUDE_DIRECTORIES "${SWITCH_PHYSFS_INCLUDE}")
+add_library(Boost::boost INTERFACE IMPORTED GLOBAL)
+set_target_properties(Boost::boost PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${BLOBBY_BOOST_INCLUDE}")
+add_compile_definitions(LUA_32BITS)
diff --git a/switch2/install-ounce.sh b/switch2/install-ounce.sh
new file mode 100644
index 0000000..7a23b4e
--- /dev/null
+++ b/switch2/install-ounce.sh
@@ -0,0 +1,105 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+#
+# Installs the Switch 2 homebrew devkit into a devkitPro installation, from
+# the [ounce] pacman repository at https://pkg.ouncebrew.org:
+#   sh install.sh
+#
+# It does these steps with devkitPro pacman (dkp-pacman, or pacman on Arch
+# Linux and MSYS2 with devkitPro's repositories):
+# 1. It adds the [ounce] repository's signing key, after checking that its
+#    fingerprint is the one below.
+# 2. It adds [ounce] to pacman's configuration.
+# 3. It installs the devkit's packages, and with them the devkitPro packages
+#    that they depend on (devkitA64, switch-tools, the CMake toolchains):
+#    - libounce: the libnx-compatible library for Switch 2, in
+#      $DEVKITPRO/libounce, with switch2vars.sh and the CMake toolchain.
+#    - ouncevk: Vulkan, EGL, OpenGL and OpenGL ES, in
+#      $DEVKITPRO/portlibs/switch2.
+#    - libkaihen: kaiHEN's homebrew API (kaihen.h), in
+#      $DEVKITPRO/portlibs/switch2.
+# Update them later as other devkitPro packages: dkp-pacman -Syu.
+set -eu
+
+# The [ounce] repository and the fingerprint of its signing key.
+REPO_URL="${OUNCE_REPO_URL:-https://pkg.ouncebrew.org}"
+SIGNING_KEY=DFEAE7FA965D1E6C0D41D4D75DB9FDBFA4A4DE29
+PACKAGES="libounce ouncevk libkaihen"
+
+# True on Windows (MSYS2), which has no sudo.
+is_windows() {
+    case "$(uname -s)" in
+    MINGW* | MSYS*) return 0 ;;
+    *) return 1 ;;
+    esac
+}
+
+# Runs a command as root, unless the current user is root or on Windows.
+as_root() {
+    if [ "$(id -u)" -eq 0 ] || is_windows; then
+        "$@"
+    else
+        sudo "$@"
+    fi
+}
+
+# Writes a URL to a file, with curl or wget.
+download() {
+    if command -v curl >/dev/null 2>&1; then
+        curl -fsSL -o "$2" "$1"
+    elif command -v wget >/dev/null 2>&1; then
+        wget -q -O "$2" "$1"
+    else
+        echo "install.sh: curl or wget is needed" >&2
+        exit 1
+    fi
+}
+
+# devkitPro pacman: dkp-pacman with its own configuration, or pacman on Arch
+# Linux and MSYS2 when it has devkitPro's repositories.
+if command -v dkp-pacman >/dev/null 2>&1; then
+    PACMAN=dkp-pacman
+    PACMAN_KEY=dkp-pacman-key
+    PACMAN_CONF=/opt/devkitpro/pacman/etc/pacman.conf
+elif command -v pacman >/dev/null 2>&1 && pacman -Sl dkp-libs >/dev/null 2>&1; then
+    PACMAN=pacman
+    PACMAN_KEY=pacman-key
+    PACMAN_CONF=/etc/pacman.conf
+else
+    cat >&2 <<MESSAGE
+install.sh: devkitPro pacman is not installed. The instructions are at
+  https://devkitpro.org/wiki/devkitPro_pacman
+Then run this script again. You can also use the Docker image instead; see
+README.md.
+MESSAGE
+    exit 1
+fi
+
+echo "Adding the [ounce] signing key $SIGNING_KEY"
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+download "$REPO_URL/ounce.gpg" "$work/ounce.gpg"
+as_root "$PACMAN_KEY" --add "$work/ounce.gpg"
+# Fails when the downloaded key is not the one named here.
+as_root "$PACMAN_KEY" --lsign-key "$SIGNING_KEY"
+
+if ! grep -q '^\[ounce\]' "$PACMAN_CONF"; then
+    echo "Adding [ounce] to $PACMAN_CONF"
+    printf '\n[ounce]\nServer = %s\n' "$REPO_URL" | as_root tee -a "$PACMAN_CONF" >/dev/null
+fi
+
+# The devkit before these packages was unpacked from an archive. Its files
+# belong to no package; the packages replace them.
+overwrite="--overwrite /opt/devkitpro/libounce/* --overwrite /opt/devkitpro/portlibs/switch2/*"
+overwrite="$overwrite --overwrite /opt/devkitpro/switch2vars.sh"
+
+echo "Installing $PACKAGES"
+# The patterns are pacman's: the shell must not expand them.
+set -f
+# shellcheck disable=SC2086
+as_root "$PACMAN" -Sy --needed --noconfirm $overwrite $PACKAGES
+set +f
+if [ -f /opt/devkitpro/ounce-devkit-version.txt ]; then
+    as_root rm -f /opt/devkitpro/ounce-devkit-version.txt
+fi
+"$PACMAN" -Q $PACKAGES
