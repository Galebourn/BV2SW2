--- /dev/null
+++ b/.github/workflows/switch2.yml
@@ -0,0 +1,26 @@
+name: Experimental Switch 2 kaiHEN build
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build NRO and game data
+        run: docker build --file switch2/Dockerfile --output type=local,dest=dist .
+      - name: Check NRO header
+        run: |
+          python3 - <<'PY'
+          from pathlib import Path
+          path = Path('dist/switch/blobby2/blobby.nro')
+          assert path.read_bytes()[16:20] == b'NRO0', 'Invalid NRO magic'
+          assert Path('dist/switch/blobby2/data/gfx.zip').is_file()
+          PY
+      - uses: actions/upload-artifact@v4
+        with:
+          name: blobby-volley-2-kaihen-experimental
+          path: dist/
+          if-no-files-found: error
